DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticketdhaka
# Optional. Leave unset to use the in-process LRU cache only.
REDIS_URL=redis://localhost:6379/0
# Host port of the Docker Postgres (docker-compose.yml). Use 5433 if a local PostgreSQL has 5432,
# and change the port in DATABASE_URL to match.
DB_PORT=5432
# Use a long random string in production (32+ bytes)
JWT_SECRET=change-me-to-a-long-random-string-32-bytes
HOLD_MINUTES=5
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=10
CACHE_ENABLED=true
SEED_DEMO_DATA=true
# Your admin account (created at startup). Logs in to /admin and to the API docs at /docs.
# Use a strong password; never commit the real one.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password
# Stripe test mode (free). Leave empty to use the built-in demo gateway instead.
# Keys: dashboard.stripe.com/test/apikeys. Webhook secret: from `stripe listen` locally,
# or from the webhook endpoint you add in the Stripe dashboard for the live site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
